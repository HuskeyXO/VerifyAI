# Application
APP_NAME=VerifyAI

# Database
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/verifyai

# AI provider: mock, gemini, or huggingface
AI_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# News provider: mock or gnews
NEWS_PROVIDER=gnews
GNEWS_API_KEY=replace_with_your_gnews_api_key

# Optional: Hugging Face fallback provider
# HF_TOKEN=replace_with_your_huggingface_token
# HF_MODEL=replace_with_your_huggingface_model
