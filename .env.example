# Application
APP_NAME=VerifyAI

# Database
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/verifyai

# AI provider
AI_PROVIDER=gemini
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Search provider: tavily or gnews
NEWS_PROVIDER=tavily
TAVILY_API_KEY=replace_with_your_tavily_api_key

# Optional alternative search provider
GNEWS_API_KEY=replace_with_your_gnews_api_key